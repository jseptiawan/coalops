# =============================================================================
# CoalOps – environment variables (sample)
# Copy to `.env` and adjust as needed, then `docker compose up`
# =============================================================================

# ---- LLM provider (Module 19 — AI Executive Summary) --------------------
# "fallback" (default, deterministic), "anthropic", or "openai"
LLM_PROVIDER=fallback

# When LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-latest

# When LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ---- Locale -------------------------------------------------------------
# "en" or "id" – default UI language on first visit. The EN/ID toggle in the
# header always overrides this and persists per browser.
DEFAULT_LOCALE=en
